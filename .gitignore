# --- Secrets: never commit anything below -----------------------------------
client_secrets.json
credentials.json
**/client_secrets.json
**/credentials.json
*.env
.env
.env.*
!.env.example
# Base64-encoded credential blobs are still credentials.
encoded_*.txt
*_secret*.json
*_secrets*.json
*-service-account*.json
token.json
token.pickle

# --- Build output -----------------------------------------------------------
output/
*.mp4
*.wav
*.mp3
!assets/music/bg_music.mp3

# --- Reference material -----------------------------------------------------
# Downloaded source media stays local: it is large, and it is somebody else's
# copyrighted work. Only the derived analysis is committed.
reference/**/source.*
reference/**/*.vtt
reference/**/*.srt
reference/**/*.part
reference/**/*.webm
reference/**/*.mkv
# ...but the analysis artifacts must be tracked.
!reference/**/analysis.json
!reference/**/metadata.json
!reference/**/transcript.txt
!reference/**/REPORT.md
!reference/**/contact_sheet.jpg
!reference/**/frames/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store

# --- Studio -----------------------------------------------------------------
# Third-party transcripts used for structural measurement stay local; only the
# derived profile is committed.
studio/corpus/*.txt
studio/examples/out/
