# Copy to .env for local runs. .env is gitignored — never commit real values.

# --- Required ---------------------------------------------------------------
# Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Optional ---------------------------------------------------------------
# Pexels key for themed slide backdrops. Without it, slides use a flat colour.
# https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Series identity --------------------------------------------------------
SERIES_NAME=Build With AI
AUTHOR_NAME=your name
SERIES_TOPIC=practical AI engineering for working developers
SERIES_AUDIENCE=a developer who can code but has no machine-learning background

# --- Behaviour --------------------------------------------------------------
# unlisted | private | public. Keep this at 'unlisted' until you trust the output —
# this pipeline publishes with no human in the loop.
PRIVACY_STATUS=unlisted

# Build videos without uploading. Set to 1 for a safe first run.
DRY_RUN=

LESSONS_PER_RUN=1
LESSONS_PER_PLAN=20
SLIDES_PER_LESSON=8
GEMINI_MODEL=gemini-2.5-flash
